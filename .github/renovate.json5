{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  // lockFileMaintenance の schedule（月曜 0〜3 時）を日本時間で解釈させる。renovate.yml の cron はこの時間帯に合わせている
  "timezone": "Asia/Tokyo",
  // CONTRIBUTING.md でタイトルを Conventional Commits 形式と定めているため、履歴からの自動判定に任せない
  "semanticCommits": "enabled",
  // ruleset で squash マージだけを許可している
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    // renovate-version には置き換えテンプレートが無く、ダイジェストを書き込めずに固定のグループごと失敗するため
    // https://github.com/renovatebot/renovate/blob/44.149.3/lib/modules/manager/github-actions/known-actions/docker-dynamic.ts
    {
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "pinDigests": false
    },
    // ここから下はタイトルの日本語化。語順が「action topic extra」で固定なので、action を空にして動詞を extra に入れる。
    // datasource（Docker など）の既定のメッセージより後に適用させるため packageRules に置く
    {
      "matchPackageNames": ["*"],
      "commitMessageAction": "",
      // 同じブランチに複数バージョンが入ると extra が消されるので、動詞を補う
      "commitMessageTopic": "{{{depName}}}{{#unless commitMessageExtra}} を更新{{/unless}}",
      "commitMessageExtra": "を {{#if isMajor}}{{{prettyNewMajor}}}{{else}}{{#if isSingleVersion}}{{{prettyNewVersion}}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}} に更新"
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "commitMessageExtra": "を {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{{newValue}}}{{/if}} に固定"
    },
    {
      "matchUpdateTypes": ["digest"],
      "commitMessageExtra": "のダイジェストを {{{newDigestShort}}} に更新"
    },
    {
      "matchUpdateTypes": ["replacement"],
      // replacement では newVersion が空になるため newValue を使う
      "commitMessageExtra": "を {{{newName}}} {{{newValue}}} に置き換え"
    },
    {
      "matchUpdateTypes": ["rollback"],
      "commitMessageExtra": "を {{{newValue}}} にロールバック"
    }
  ],
  // グループの topic はブランチ生成時に packageRules より後で上書きされるため、別途日本語にする
  "group": {
    "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} を更新{{/unless}}"
  },
  "pin": {
    "group": {
      "commitMessageTopic": "依存関係を固定"
    }
  },
  "pinDigest": {
    "group": {
      "commitMessageTopic": "依存関係を固定"
    }
  },
  "lockFileMaintenance": {
    "commitMessageAction": "ロックファイルを更新"
  }
}
