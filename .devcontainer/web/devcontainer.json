{
  "name": "web",
  "dockerComposeFile": ["../../compose.yaml"],
  "service": "web",
  // Compose の既定の stopCompose は、ウィンドウを閉じると api のコンテナも止め、api で開いているウィンドウが切れるため
  // https://containers.dev/implementors/json_reference/
  "shutdownAction": "none",
  "workspaceFolder": "/workspace/web",
  // Linux で UID を手元のユーザーに合わせる処理は、開いたコンテナにしかかからず、一緒に起動したコンテナは 1000 のまま残るため
  // https://github.com/kentayamada-dev/playground/pull/235
  "runServices": ["web"],
  "remoteUser": "dev"
}
