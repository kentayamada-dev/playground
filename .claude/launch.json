{
  "version": "0.0.1",
  // docker compose（CLI のプラグイン）は止めたときに SIGTERM をコンテナへ転送しないことがあり、コンテナが残ってポートを使い続けるため、単体の docker-compose を使う
  // https://github.com/kentayamada-dev/playground/pull/276
  "configurations": [
    {
      "name": "golang",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "run",
        "--rm",
        "--use-aliases",
        "--publish",
        "8080:8080",
        "--name",
        "playground-golang-preview",
        "golang",
        "go",
        "run",
        "."
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "node",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "run",
        "--rm",
        "--publish",
        "3000:3000",
        "--name",
        "playground-node-preview",
        "node",
        "pnpm",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "studio",
      "runtimeExecutable": "docker-compose",
      // run は compose.yaml の ports を公開しないため、up を使う https://docs.docker.com/reference/cli/docker/compose/run/
      // 依存先として起動させただけのサービスは、プレビューを止めても動いたまま残るため、meta・db も並べて一緒に止める
      "runtimeArgs": ["up", "studio", "meta", "db"],
      // 内蔵ブラウザは / がリダイレクトを返すあいだ準備完了と見なさず、Studio の / は 307 を返すため、Awaiting server… のまま移らない。
      // 起動したら http://localhost:54323 へ移動する。挙動は手元の実験で確かめたもので、ドキュメントには書かれていない
      "port": 54323,
      "autoPort": false
    }
  ]
}
