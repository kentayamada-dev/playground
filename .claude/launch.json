{
  "version": "0.0.1",
  // docker compose（CLI のプラグイン）は止めたときに SIGTERM をコンテナへ転送しないことがあり、コンテナが残ってポートを使い続けるため、単体の docker-compose を使う
  // https://github.com/kentayamada-dev/playground/pull/276
  "configurations": [
    {
      "name": "golang",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "run",
        "--rm",
        "--use-aliases",
        "--publish",
        "8080:8080",
        "--name",
        "playground-golang-preview",
        "golang",
        "go",
        "run",
        "."
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "node",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "run",
        "--rm",
        "--publish",
        "3000:3000",
        "--name",
        "playground-node-preview",
        "node",
        "pnpm",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "studio",
      "runtimeExecutable": "docker-compose",
      // run と違い、compose.yaml の ports のまま公開する。プレビューを止めても止まるのは studio だけで、meta・db は動いたまま残る
      "runtimeArgs": ["up", "studio"],
      // 内蔵ブラウザは Awaiting server… のまま Studio に移らない（原因は未確認）ため、起動したら http://localhost:54323 へ移動する
      "port": 54323,
      "autoPort": false
    }
  ]
}
