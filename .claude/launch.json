{
  "version": "0.0.1",
  // docker compose（CLI のプラグイン）は止めたときに SIGTERM をコンテナへ転送しないことがあり、コンテナが残ってポートを使い続けるため、単体の docker-compose を使う
  // https://github.com/kentayamada-dev/playground/pull/276
  "configurations": [
    {
      "name": "golang",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "run",
        "--rm",
        "--use-aliases",
        "--publish",
        "8080:8080",
        "--workdir",
        "/workspace/golang",
        "--name",
        "playground-golang-preview",
        "golang",
        "go",
        "run",
        "."
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "nodejs",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "run",
        "--rm",
        "--publish",
        "3000:3000",
        "--workdir",
        "/workspace/nodejs",
        "--name",
        "playground-nodejs-preview",
        "nodejs",
        "pnpm",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}
