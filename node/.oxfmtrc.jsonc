{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // CSS は import した順に並び、同じ詳細度なら後のものが勝つため、グローバルな CSS を読み込む値を受け取らない import を最後に置き、ほかの import の CSS より優先させる
  // sortSideEffects を有効にしないと、値を受け取らない import は書いた位置から動かない https://nextjs.org/docs/app/getting-started/css#ordering-and-merging
  "sortImports": {
    "sortSideEffects": true,
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown",
      "side_effect_style",
    ],
  },
}
